# Local development needs nothing: the database defaults to file:data/benches.db
# and the staff page is disabled until ADMIN_TOKEN is set.

# Database (Turso in production; a local file otherwise)
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=...

# Enables /admin. Pick a long random string.
# ADMIN_TOKEN=
